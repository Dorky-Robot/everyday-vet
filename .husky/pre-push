#!/usr/bin/env bash
# .husky/pre-push — full validation before push
#
# Hook chain:
#   1. Playwright E2E tests  (BLOCKING)
#   2. Secrets scan          (gitleaks — BLOCKING)
#
# Activate once per clone:
#   git config core.hooksPath .husky

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

warn() { echo "  WARN  $*" >&2; }
fail() { echo "  ERROR $*" >&2; exit 1; }
step() { echo ""; echo "==> $*"; }

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  pre-push checks (Everyday Vet)"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# ── 1. Playwright E2E tests (BLOCKING) ───────────────────────────────────────
step "[1/2] E2E tests (Playwright)"
if command -v npx >/dev/null 2>&1 && [ -f "playwright.config.js" ] || [ -f "playwright.config.ts" ]; then
    if ! npx playwright test; then
        fail "E2E tests failed — push blocked. Fix test failures before pushing."
    fi
    echo "      OK  All E2E tests passed"
elif ls tests/*.spec.* >/dev/null 2>&1; then
    if ! npx playwright test; then
        fail "E2E tests failed — push blocked. Fix test failures before pushing."
    fi
    echo "      OK  All E2E tests passed"
else
    warn "No Playwright config or test files found — skipping E2E tests."
    warn "Add a playwright.config.js and tests/ directory to enable."
fi

# ── 2. Secrets scan (BLOCKING) ───────────────────────────────────────────────
step "[2/2] Secrets scan (gitleaks)"
if command -v gitleaks >/dev/null 2>&1; then
    if ! gitleaks git --no-banner --verbose; then
        fail "Secrets detected — push blocked. Remove secrets before pushing."
    fi
    echo "      OK  No secrets detected"
else
    warn "gitleaks not installed — skipping secrets scan."
    warn "Install: brew install gitleaks"
fi

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  All pre-push checks passed — proceeding with push."
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
