#!/usr/bin/env bash
# .husky/pre-commit — fast, deterministic checks before every commit
#
# Hook chain:
#   1. Secrets scan   (gitleaks — BLOCKING)
#   2. Spell check    (typos — BLOCKING)
#   3. Formatting     (prettier — BLOCKING)
#   4. HTML validation (htmlhint — BLOCKING)
#
# Activate once per clone:
#   git config core.hooksPath .husky

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

warn() { echo "  WARN  $*" >&2; }
fail() { echo "  ERROR $*" >&2; exit 1; }
step() { echo ""; echo "==> $*"; }

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  pre-commit checks (Everyday Vet)"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# ── 1. Secrets scan (BLOCKING) ────────────────────────────────────────────────
step "[1/4] Secrets scan (gitleaks)"
if command -v gitleaks >/dev/null 2>&1; then
    if ! gitleaks git --pre-commit --no-banner --verbose; then
        fail "Secrets detected — commit blocked. Remove secrets before committing."
    fi
    echo "      OK  No secrets detected"
else
    warn "gitleaks not installed — skipping secrets scan."
    warn "Install: brew install gitleaks"
fi

# ── 2. Spell check (BLOCKING) ────────────────────────────────────────────────
step "[2/4] Spell check (typos)"
if command -v typos >/dev/null 2>&1; then
    if ! typos --format brief; then
        fail "Spelling errors found — commit blocked. Fix typos before committing."
    fi
    echo "      OK  No spelling errors"
else
    warn "typos not installed — skipping spell check."
    warn "Install: brew install typos-cli"
fi

# ── 3. Formatting (BLOCKING) ─────────────────────────────────────────────────
step "[3/4] Formatting (prettier)"
if command -v npx >/dev/null 2>&1 && npx prettier --version >/dev/null 2>&1; then
    if ! npx prettier --check "*.html" "*.css" "*.json" 2>/dev/null; then
        fail "Formatting issues found — commit blocked. Run: npx prettier --write ."
    fi
    echo "      OK  All files formatted"
else
    warn "prettier not available — skipping format check."
    warn "Install: npm install --save-dev prettier"
fi

# ── 4. HTML validation (BLOCKING) ────────────────────────────────────────────
step "[4/4] HTML validation"
if command -v npx >/dev/null 2>&1 && npx htmlhint --version >/dev/null 2>&1; then
    if ! npx htmlhint "*.html"; then
        fail "HTML validation errors — commit blocked. Fix HTML issues before committing."
    fi
    echo "      OK  HTML is valid"
else
    warn "htmlhint not available — skipping HTML validation."
    warn "Install: npm install --save-dev htmlhint"
fi

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  All pre-commit checks passed — proceeding with commit."
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
